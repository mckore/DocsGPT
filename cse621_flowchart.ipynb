flowchart TB
    A[("Raw Text Documents<br/>(2,000 Movie Reviews)")]
    
    subgraph PREP["🔧 Preprocessing Stage"]
        direction LR
        P1["Basic<br/>Tokenization"]
        P2["Stopword<br/>Removal"]
        P3["Stemming<br/>(Porter)"]
        P4["Lemmatization<br/>(WordNet)"]
    end
    
    subgraph FEAT["Feature Extraction Stage"]
        direction TB
        subgraph VEC["Vectorization"]
            V1["Term Frequency<br/>(CountVectorizer)"]
            V2["TF-IDF<br/>(TfidfVectorizer)"]
        end
        subgraph NGRAM["N-gram Options"]
            N1["Unigram (1,1)"]
            N2["Bigram (1,2)"]
        end
    end
    
    subgraph SELECT["Feature Selection Stage"]
        direction LR
        S1["Chi-Squared<br/>(SelectKBest)"]
        S2["Mutual Information<br/>(SelectKBest)"]
        S3[("k = 1000, 2000, 5000")]
    end
    
    subgraph CLASS["Classification Stage"]
        direction LR
        C1["Naive Bayes<br/>• Multinomial<br/>• Bernoulli<br/>• α = 0.1, 0.5, 1.0"]
        C2["Logistic Regression<br/>• C = 0.1, 1.0, 10<br/>• L1/L2 Penalty"]
        C3["SVM<br/>• Linear Kernel<br/>• C = 0.1, 1.0, 10"]
    end
    
    subgraph ENS["Ensemble Stage"]
        direction LR
        E1["Voting<br/>(Hard/Soft)"]
        E2["Bagging"]
        E3["Random<br/>Forest"]
        E4["Gradient<br/>Boosting"]
    end
    
    subgraph EVAL["Evaluation Loop"]
        direction TB
        EV1["5-Fold Stratified Cross-Validation"]
        EV2["Accuracy | Precision | Recall | F1-Score<br/>(Mean ± Std)"]
    end
    
    A --> PREP
    PREP --> FEAT
    VEC --> NGRAM
    FEAT --> SELECT
    S1 --> S3
    S2 --> S3
    SELECT --> CLASS
    CLASS --> ENS
    ENS --> EVAL
    EV1 --> EV2
    
    style A fill:#e1f5fe
    style PREP fill:#fff3e0
    style FEAT fill:#e8f5e9
    style SELECT fill:#fce4ec
    style CLASS fill:#f3e5f5
    style ENS fill:#fff8e1
    style EVAL fill:#e0f2f1